{
  "name": "dsh-go-runtime-kit",
  "version": "1.2.2",
  "description": "Runtime context kit for DSH Go: layered reply profile, tool-gate defaults and prompt assembly normalization. No host source files are patched.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "rtkit-install": "./bin/install.mjs",
    "rtkit-uninstall": "./bin/uninstall.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddd000555/dsh-go-runtime-kit.git"
  },
  "homepage": "https://github.com/ddd000555/dsh-go-runtime-kit#readme",
  "bugs": {
    "url": "https://github.com/ddd000555/dsh-go-runtime-kit/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-go",
    "cordis",
    "prompt",
    "profile"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
